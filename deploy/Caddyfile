{
	email admin@book-nest.net
}

book-nest.net {
	encode zstd gzip

	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		reverse_proxy api-prod:4000
	}

	handle {
		reverse_proxy web-prod:3000
	}
}

dev.book-nest.net {
	encode zstd gzip

	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		reverse_proxy api-dev:4000
	}

	handle {
		reverse_proxy web-dev:3000
	}
}

mail.book-nest.net {
	encode zstd gzip

	basic_auth {
		team {env.MAILPIT_BASIC_AUTH_HASH}
	}

	reverse_proxy mailpit:8025
}
