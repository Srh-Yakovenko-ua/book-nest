PROD_POSTGRES_USER=booknest
PROD_POSTGRES_PASSWORD=
PROD_POSTGRES_DB=booknest
PROD_TAG=prod
PROD_LOG_LEVEL=info
PROD_ENABLE_SWAGGER=false

DEV_POSTGRES_USER=booknest
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_DB=booknest
DEV_TAG=dev
DEV_LOG_LEVEL=debug
DEV_ENABLE_SWAGGER=true

# Auth — JWT secrets, one DISTINCT pair per environment, each >= 32 chars.
# Generate each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating a refresh secret invalidates all sessions + pending verification tokens for that env.
PROD_JWT_ACCESS_SECRET=
PROD_JWT_REFRESH_SECRET=
DEV_JWT_ACCESS_SECRET=
DEV_JWT_REFRESH_SECRET=

# Outgoing mail (prod) — Mailtrap Sending. Host/port/user default to Mailtrap's live relay
# (live.smtp.mailtrap.io:587, STARTTLS, user "api"); only the API token is a secret.
# Set PROD_SMTP_PASS to your Mailtrap API token so prod can actually deliver. Until it's set,
# prod boots but emails silently fail (fire-and-forget). The MAIL_FROM domain (book-nest.net)
# must be verified in Mailtrap (SPF/DKIM/DMARC) for delivery.
PROD_SMTP_PASS=
# Overrides (rarely needed — defaults match Mailtrap Sending):
# PROD_SMTP_HOST=live.smtp.mailtrap.io
# PROD_SMTP_PORT=587
# PROD_SMTP_SECURE=false
# PROD_SMTP_USER=api

API_IMAGE=ghcr.io/srh-yakovenko-ua/booknest-api
WEB_IMAGE=ghcr.io/srh-yakovenko-ua/booknest-web
