{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "mailtrap": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-mailtrap"],
      "env": {
        "MAILTRAP_API_TOKEN": "${MAILTRAP_API_TOKEN}",
        "MAILTRAP_ACCOUNT_ID": "${MAILTRAP_ACCOUNT_ID}"
      }
    }
  }
}
