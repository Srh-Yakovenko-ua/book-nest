{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".env",
    ".env.local",
    "pnpm-workspace.yaml",
    ".prettierrc",
    ".prettierignore",
    "eslint.config.mjs"
  ],
  "globalEnv": ["NODE_ENV", "CI", "APP_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx,css,html,json}",
        "tsconfig*.json",
        "next.config.ts",
        "postcss.config.mjs",
        "package.json",
        "public/**"
      ],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_BASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig*.json", "package.json", "src/env.d.ts"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "eslint.config.mjs", "package.json", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "vitest.config.ts",
        "vitest.setup.ts",
        "package.json",
        "tsconfig*.json",
        "prisma/schema.prisma",
        "prisma/migrations/**"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "CORS_ORIGINS",
        "ENABLE_SWAGGER",
        "LOG_LEVEL",
        "PORT",
        "TRACING_ENABLED"
      ],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
