# LOCAL app pointed at the DEV server's Postgres via SSH tunnel.
# Usage:
#   1) open the tunnel (separate terminal):  pnpm tunnel:dev   (local :5532 → dev db)
#   2) run:                                   pnpm dev:api:dev
# Copy this file to .env.dev and fill the blanks. .env.dev is gitignored.
# Field docs live in .env.local.example — this file only notes what differs for dev.
NODE_ENV=development
PORT=4000
# DEV DB over the tunnel. Password = DEV_POSTGRES_PASSWORD (Bitwarden / GitHub Secret / server ~/booknest/.env).
DATABASE_URL=postgresql://booknest:__DEV_DB_PASSWORD__@localhost:5532/booknest
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
ENABLE_SWAGGER=true
TRACING_ENABLED=false
# Use the DEV environment's JWT secrets so locally-issued tokens match dev sessions
# (DEV_JWT_ACCESS_SECRET / DEV_JWT_REFRESH_SECRET — GitHub Secrets / Bitwarden).
JWT_ACCESS_SECRET=__DEV_JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__DEV_JWT_REFRESH_SECRET__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_SHORT=1
COOKIE_SECURE=false
EMAIL_VERIFICATION_TTL_MINUTES=60
RESEND_COOLDOWN_SECONDS=60
# Mail stays on your LOCAL Mailpit so local runs never send through dev/prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=BookNest <no-reply@book-nest.net>
WEB_BASE_URL=https://dev.book-nest.net
WIKIDATA_CONTACT=book-nest/1.0 (+https://book-nest.net)
# Object storage — Cloudflare R2 dev bucket. Without these the app falls back to local MinIO
# (see .env.local.example). The R2 API token (R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY) is a
# secret — Bitwarden / GitHub Secret / server ~/booknest/.env. R2_ENDPOINT is the S3 API host
# (account id, NO bucket in the path); R2_PUBLIC_BASE_URL is the bucket's public custom domain
# for serving images (NOT the cloudflarestorage.com host).
R2_ENDPOINT=https://__R2_ACCOUNT_ID__.r2.cloudflarestorage.com
R2_BUCKET=book-nest-dev
R2_PUBLIC_BASE_URL=https://media.dev.book-nest.net
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
R2_ACCESS_KEY_ID=__R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__R2_SECRET_ACCESS_KEY__
