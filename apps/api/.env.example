NODE_ENV=development
PORT=4000

# Postgres connection used by the runtime app.
# Locally: direct connection to your local postgres (managed via pgAdmin/psql).
# On Vercel: Supabase Transaction Pooler (port 6543) — pgbouncer-friendly for serverless.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Optional. Set only when DATABASE_URL points at a pgbouncer transaction pooler
# (Supabase Transaction Pooler on port 6543). Migrations require prepared statements
# and session-level operations, which transaction-mode poolers don't support — so point
# `prisma migrate` at this direct/session URL instead. On Vercel use Supabase Session
# Pooler (same host, port 5432) or Direct connection (IPv6-only).
# Locally leave this unset — DATABASE_URL is used for both runtime and migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed Origins for CORS. Vercel single-domain deploys
# can keep just the prod URL here; preview deploys need their own URL or a wildcard pattern.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# Swagger UI at /api/docs. Defaults to "true". Set to "false" to hide in any env.
ENABLE_SWAGGER=true

# OpenTelemetry distributed tracing. When "true" the NodeSDK initializes
# auto-instrumentations (http, express, pg, ...) and prints span trees to stdout
# via ConsoleSpanExporter. Keep "false" by default — exporter is noisy.
TRACING_ENABLED=false

# Cloudflare R2 (S3-compatible object storage) — for file uploads (book covers, avatars).
# NOT yet read by config/env.ts — uncomment + wire when the upload feature lands.
# Real dev creds live in Bitwarden ("Book Nest — R2 dev"); never commit secrets here.
# Per environment: bucket book-nest-dev (dev) / book-nest-prod (prod); locally MinIO or the dev bucket.
# R2_ACCOUNT_ID=
# R2_BUCKET=book-nest-dev
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
