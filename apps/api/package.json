{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --conditions=source --watch --enable-source-maps src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migration:generate": "tsx --conditions=source ./node_modules/typeorm/cli.js migration:generate src/core/database/migrations/Init -d src/core/database/data-source.ts",
    "db:migration:run": "tsx --conditions=source ./node_modules/typeorm/cli.js migration:run -d src/core/database/data-source.ts",
    "db:migration:revert": "tsx --conditions=source ./node_modules/typeorm/cli.js migration:revert -d src/core/database/data-source.ts",
    "db:migration:show": "tsx --conditions=source ./node_modules/typeorm/cli.js migration:show -d src/core/database/data-source.ts",
    "db:schema:drop": "tsx --conditions=source ./node_modules/typeorm/cli.js schema:drop -d src/core/database/data-source.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "bcryptjs": "catalog:",
    "compression": "catalog:",
    "cookie-parser": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "catalog:",
    "helmet": "catalog:",
    "jose": "catalog:",
    "nestjs-zod": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "typeorm-naming-strategies": "catalog:",
    "ua-parser-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/compression": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
