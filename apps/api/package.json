{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --conditions=source --watch --enable-source-maps src/index.ts",
    "build": "tsc -p tsconfig.build.json && pnpm copy:assets",
    "copy:assets": "node --import @swc-node/register/esm-register --conditions=source scripts/copy-assets.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "node --import @swc-node/register/esm-register --conditions=source src/scripts/generate-openapi.ts",
    "seed:authors": "node --import @swc-node/register/esm-register --conditions=source src/scripts/seed-authors.ts",
    "seed:changelog": "node --import @swc-node/register/esm-register --conditions=source src/scripts/seed-changelog.ts",
    "seed:delivery-services": "node --import @swc-node/register/esm-register --conditions=source src/scripts/seed-delivery-services.ts",
    "seed:genres": "node --import @swc-node/register/esm-register --conditions=source src/scripts/seed-genres.ts",
    "seed:publishers": "node --import @swc-node/register/esm-register --conditions=source src/scripts/seed-publishers.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node --import @swc-node/register/esm-register --conditions=source scripts/migrate.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "bcryptjs": "catalog:",
    "compression": "catalog:",
    "cookie-parser": "catalog:",
    "date-fns": "catalog:",
    "date-fns-tz": "catalog:",
    "dotenv": "catalog:",
    "file-type": "catalog:",
    "helmet": "catalog:",
    "jose": "catalog:",
    "nestjs-zod": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "prisma": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "ua-parser-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/compression": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "pg": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
