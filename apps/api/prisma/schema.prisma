  sourceEvent   BookTimelineEvent @relation("RelationSource", fields: [sourceEventId], references: [id], onDelete: Cascade)
  targetEvent   BookTimelineEvent @relation("RelationTarget", fields: [targetEventId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, targetEventId, relationType])
  @@index([targetEventId])
  @@map("book_timeline_event_relations")
}

model Character {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @map("user_id") @db.Uuid
  name                  String
  normalizedName        String                     @map("normalized_name")
  entityKind            String                     @default("individual") @map("entity_kind")
  species               String?
  gender                String                     @default("unknown")
  customGender          String?                    @map("custom_gender")
  pronouns              String?
  neutralDescription    String?                    @map("neutral_description")
  avatarMediaId         String?                    @map("avatar_media_id") @db.Uuid
  isFavorite            Boolean                    @default(false) @map("is_favorite")
  hideProfileAsSpoiler  Boolean                    @default(false) @map("hide_profile_as_spoiler")
  globalAttitude        String?                    @map("global_attitude")
  archivedAt            DateTime?                  @map("archived_at") @db.Timestamptz
  deletedAt             DateTime?                  @map("deleted_at") @db.Timestamptz
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia           MediaAsset?                @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)
  aliases               CharacterAlias[]
  bookAppearances       BookCharacter[]
  forms                 CharacterForm[]
  tags                  CharacterTag[]
  groupMemberships      CharacterGroupMembership[]
  theories              CharacterTheory[]
  outgoingRelationships CharacterRelationship[]    @relation("outgoingRelationships")
  incomingRelationships CharacterRelationship[]    @relation("incomingRelationships")

  @@index([userId, normalizedName])
  @@index([userId, isFavorite])
  @@index([userId, archivedAt])
  @@index([userId, deletedAt])
  @@index([avatarMediaId])
  @@map("characters")
}

