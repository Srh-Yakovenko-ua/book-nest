generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  super_admin

  @@map("role")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              Role      @default(user) @map("role")
  nickname          String?   @unique
  lastName          String?   @map("last_name")
  bio               String?   @map("bio")
  avatarUrl         String?   @map("avatar_url")
  favoriteBookQuote String?   @map("favorite_book_quote")
  favoriteGenres    String[]  @default([]) @map("favorite_genres")
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions                  Session[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  socialLinks               UserSocialLink[]
  settings                  UserProfileSettings?
  authors                   Author[]
  publishers                Publisher[]
  books                     Book[]
  tags                      Tag[]
  series                    Series[]
  bookLists                 BookList[]
  customGenres              Genre[]
  mediaAssets               MediaAsset[]
  bookDeliveries            BookDelivery[]
  bookLoans                 BookLoan[]
  bookStoreLinks            BookStoreLink[]
  deliveryServices          DeliveryService[]
  changelogRead             ChangelogRead?
  seriesOrderIgnoredIssues  SeriesOrderIgnoredIssue[]
  seriesOrderDisabledSeries SeriesOrderDisabledSeries[]
  quotes                    Quote[]
  notes                     Note[]
  characters                Character[]
  characterGroups           CharacterGroup[]
  characterTheories         CharacterTheory[]
  characterRelationships    CharacterRelationship[]
  characterGraphLayouts     CharacterGraphLayout[]

  @@map("users")
}

enum ChangelogCategory {
  feature
  improvement
  fix

  @@map("changelog_category")
}

model ChangelogEntry {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique
  version     String?
  category    ChangelogCategory
  titleUk     String            @map("title_uk")
  titleEn     String            @map("title_en")
  bodyUk      String            @map("body_uk")
  bodyEn      String            @map("body_en")
  publishedAt DateTime?         @map("published_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("changelog_entries")
}

model ChangelogRead {
  userId     String   @id @map("user_id") @db.Uuid
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("changelog_reads")
}

model Series {
  id                   String                      @id @default(uuid()) @db.Uuid
  userId               String                      @map("user_id") @db.Uuid
  name                 String
  normalizedName       String                      @map("normalized_name")
  status               String                      @default("unknown")
  totalBooks           Int?                        @map("total_books")
  description          String?
  genres               String[]                    @default([])
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  books                Book[]
  authors              SeriesAuthor[]
  orderIgnoredIssues   SeriesOrderIgnoredIssue[]
  orderDisabledEntries SeriesOrderDisabledSeries[]
  notes                Note[]
  characterGroups      CharacterGroup[]
  characterTheories    CharacterTheory[]

  @@unique([userId, normalizedName])
  @@map("series")
}

model Author {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String?        @map("user_id") @db.Uuid
  name             String
  normalizedName   String         @map("normalized_name")
  searchText       String         @default("") @map("search_text")
  bio              String?
  photoUrl         String?        @map("photo_url")
  photoLicense     String?        @map("photo_license")
  photoAttribution String?        @map("photo_attribution")
  photoLicenseUrl  String?        @map("photo_license_url")
  countryCode      String?        @map("country_code")
  birthYear        Int?           @map("birth_year")
  deathYear        Int?           @map("death_year")
  wikidataId       String?        @unique @map("wikidata_id")
  openLibraryKey   String?        @unique @map("open_library_key")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookAuthors      BookAuthor[]
  names            AuthorName[]
  seriesAuthors    SeriesAuthor[]

  @@unique([userId, normalizedName])
  @@index([normalizedName])
  @@map("authors")
}

model AuthorName {
  id             String  @id @default(uuid()) @db.Uuid
  authorId       String  @map("author_id") @db.Uuid
  locale         String
  name           String
  normalizedName String  @map("normalized_name")
  isPrimary      Boolean @default(false) @map("is_primary")
  author         Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, locale, normalizedName])
  @@index([authorId])
  @@index([normalizedName])
  @@map("author_names")
}

model Publisher {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  name            String
  normalizedName  String          @map("normalized_name")
  searchText      String          @default("") @map("search_text")
  countryCode     String?         @map("country_code")
  foundedYear     Int?            @map("founded_year")
  websiteUrl      String?         @map("website_url")
  logoUrl         String?         @map("logo_url")
  logoLicense     String?         @map("logo_license")
  logoAttribution String?         @map("logo_attribution")
  logoLicenseUrl  String?         @map("logo_license_url")
  wikidataId      String?         @unique @map("wikidata_id")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  books           Book[]
  names           PublisherName[]

  @@unique([userId, normalizedName])
  @@index([normalizedName])
  @@map("publishers")
}

model PublisherName {
  id             String    @id @default(uuid()) @db.Uuid
  publisherId    String    @map("publisher_id") @db.Uuid
  locale         String
  name           String
  normalizedName String    @map("normalized_name")
  isPrimary      Boolean   @default(false) @map("is_primary")
  publisher      Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([publisherId, locale, normalizedName])
  @@index([publisherId])
  @@index([normalizedName])
  @@map("publisher_names")
}

model Book {
  id                            String                           @id @default(uuid()) @db.Uuid
  userId                        String                           @map("user_id") @db.Uuid
  title                         String
  firstAuthorName               String                           @default("") @map("first_author_name")
  publisherId                   String?                          @map("publisher_id") @db.Uuid
  description                   String?
  genres                        String[]                         @default([])
  formats                       String[]                         @default([])
  language                      String                           @default("ukrainian")
  ageCategory                   String                           @default("not_specified") @map("age_category")
  readingStatus                 String                           @default("not_started") @map("reading_status")
  ownershipStatus               String                           @default("none") @map("ownership_status")
  isFavorite                    Boolean                          @default(false) @map("is_favorite")
  isFavoriteDedication          Boolean                          @default(false) @map("is_favorite_dedication")
  favoriteAddedAt               DateTime?                        @map("favorite_added_at") @db.Timestamptz
  pagesCount                    Int?                             @map("pages_count")
  pagesCountUnavailable         Boolean                          @default(false) @map("pages_count_unavailable")
  publicationYear               Int?                             @map("publication_year")
  isbn                          String?
  originalTitle                 String?                          @map("original_title")
  translator                    String?
  illustrator                   String?
  dedication                    String?
  seriesId                      String?                          @map("series_id") @db.Uuid
  partNumber                    Int?                             @map("part_number")
  queuePriority                 String?                          @map("queue_priority")
  queuePriorityReason           String?                          @map("queue_priority_reason")
  queuePriorityReasonCustomText String?                          @map("queue_priority_reason_custom_text")
  queuePriorityTargetDate       DateTime?                        @map("queue_priority_target_date") @db.Date
  queuePosition                 Int?                             @map("queue_position")
  coverMediaId                  String?                          @map("cover_media_id") @db.Uuid
  createdAt                     DateTime                         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime                         @updatedAt @map("updated_at") @db.Timestamptz
  user                          User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  authors                       BookAuthor[]
  publisher                     Publisher?                       @relation(fields: [publisherId], references: [id])
  series                        Series?                          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  coverMedia                    MediaAsset?                      @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  tags                          BookTag[]
  lists                         BookListItem[]
  readingProgress               BookReadingProgress?
  readingEvents                 BookReadingProgressEvent[]
  purchaseInfo                  BookPurchaseInfo?
  deliveries                    BookDelivery[]
  loans                         BookLoan[]
  storeLinks                    BookStoreLink[]
  quotes                        Quote[]
  notes                         Note[]
  timelines                     BookTimeline[]
  timelineEvents                BookTimelineEvent[]
  bookCharacters                BookCharacter[]
  characterAliases              CharacterAlias[]
  characterGroupMemberships     CharacterGroupMembership[]
  characterTheories             CharacterTheory[]
  characterRelationshipStates   CharacterRelationshipBookState[]

  @@unique([seriesId, partNumber])
  @@index([userId, firstAuthorName])
  @@index([userId, createdAt(sort: Desc), id])
  @@index([userId, ownershipStatus])
  @@index([userId, readingStatus])
  @@index([publisherId])
  @@index([seriesId])
  @@index([coverMediaId])
  @@map("books")
}

model BookAuthor {
  bookId   String @map("book_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  position Int    @default(0)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id])

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

model SeriesAuthor {
  seriesId String @map("series_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id])

  @@id([seriesId, authorId])
  @@index([authorId])
  @@map("series_authors")
}

model BookReadingProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  bookId               String    @unique @map("book_id") @db.Uuid
  currentPage          Int?      @map("current_page")
  startedAt            DateTime? @map("started_at") @db.Date
  finishedAt           DateTime? @map("finished_at") @db.Date
  pausedAt             DateTime? @map("paused_at") @db.Date
  abandonedAt          DateTime? @map("abandoned_at") @db.Date
  rating               Float?
  note                 String?
  impression           String?
  lastProgressUpdateAt DateTime? @map("last_progress_update_at") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  book                 Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("book_reading_progress")
}

model BookReadingProgressEvent {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  date      DateTime @db.Date
  page      Int
  pagesRead Int      @map("pages_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, date])
  @@map("book_reading_progress_events")
}

model BookPurchaseInfo {
  id            String    @id @default(uuid()) @db.Uuid
  bookId        String    @unique @map("book_id") @db.Uuid
  storeName     String?   @map("store_name")
  storeUrl      String?   @map("store_url")
  expectedPrice Decimal?  @map("expected_price") @db.Decimal(10, 2)
  currency      String?
  note          String?
  purchasedAt   DateTime? @map("purchased_at") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("book_purchase_info")
}

model BookDelivery {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  bookId               String    @map("book_id") @db.Uuid
  storeName            String?   @map("store_name")
  orderDate            DateTime? @map("order_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  orderNumber          String?   @map("order_number")
  trackingUrl          String?   @map("tracking_url")
  trackingNumber       String?   @map("tracking_number")
  deliveryService      String?   @map("delivery_service")
  price                Decimal?  @db.Decimal(10, 2)
  currency             String?
  note                 String?
  status               String    @default("ordered")
  cancelReason         String?   @map("cancel_reason")
  receivedAt           DateTime? @map("received_at") @db.Timestamptz
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book                 Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId, status])
  @@map("book_deliveries")
}

model BookLoan {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  bookId             String    @map("book_id") @db.Uuid
  type               String
  personName         String    @map("person_name")
  contact            String?   @map("contact")
  loanDate           DateTime? @map("loan_date") @db.Date
  expectedReturnDate DateTime? @map("expected_return_date") @db.Date
  note               String?
  remindToReturn     Boolean   @default(false) @map("remind_to_return")
  status             String    @default("active")
  returnedAt         DateTime? @map("returned_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book               Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId, status])
  @@map("book_loans")
}

model BookStoreLink {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  storeName String   @map("store_name")
  url       String
  price     Decimal? @db.Decimal(10, 2)
  currency  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, url])
  @@index([bookId])
  @@index([userId])
  @@map("book_store_links")
}

model Note {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  entityType     String   @map("entity_type")
  bookId         String?  @map("book_id") @db.Uuid
  seriesId       String?  @map("series_id") @db.Uuid
  text           String
  category       String?
  customCategory String?  @map("custom_category")
  chapter        String?
  page           Int?
  isSpoiler      Boolean  @default(false) @map("is_spoiler")
  isFavorite     Boolean  @default(false) @map("is_favorite")
  isPinned       Boolean  @default(false) @map("is_pinned")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book           Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  series         Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([seriesId])
  @@index([userId, entityType])
  @@map("notes")
}

model Tag {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  name           String
  normalizedName String         @map("normalized_name")
  type           String         @default("custom")
  color          String?
  description    String?
  lastUsedAt     DateTime?      @map("last_used_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  books          BookTag[]
  characters     CharacterTag[]

  @@unique([userId, normalizedName])
  @@map("tags")
}

model BookTag {
  bookId String @map("book_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
  @@map("book_tags")
}

model Genre {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @map("key")
  name           String   @map("name")
  normalizedName String   @map("normalized_name")
  groupKey       String   @map("group_key")
  groupName      String   @map("group_name")
  isDefault      Boolean  @default(false) @map("is_default")
  sortOrder      Int      @default(0) @map("sort_order")
  userId         String?  @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([key])
  @@map("genres")
}

model DeliveryService {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  countryCode    String?  @map("country_code")
  isDefault      Boolean  @default(false) @map("is_default")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@map("delivery_services")
}

model BookList {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  name           String
  normalizedName String         @map("normalized_name")
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          BookListItem[]

  @@unique([userId, normalizedName])
  @@map("book_lists")
}

model BookListItem {
  listId   String   @map("list_id") @db.Uuid
  bookId   String   @map("book_id") @db.Uuid
  position Int      @map("position")
  addedAt  DateTime @default(now()) @map("added_at") @db.Timestamptz
  list     BookList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([listId, bookId])
  @@index([bookId])
  @@map("book_list_items")
}

model UserProfileSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  themeMode             String   @default("system") @map("theme_mode")
  accentColor           String   @default("brown") @map("accent_color")
  language              String   @default("uk")
  dateFormat            String   @default("DD.MM.YYYY") @map("date_format")
  weekStartDay          String   @default("monday") @map("week_start_day")
  timezone              String   @default("Europe/Kyiv")
  libraryViewMode       String   @default("grid") @map("library_view_mode")
  confirmBeforeDelete   Boolean  @default(true) @map("confirm_before_delete")
  readingReminders      Boolean  @default(false) @map("reading_reminders")
  readingGoalReminders  Boolean  @default(false) @map("reading_goal_reminders")
  borrowedBookReminders Boolean  @default(true) @map("borrowed_book_reminders")
  deliveryReminders     Boolean  @default(true) @map("delivery_reminders")
  weeklyReadingSummary  Boolean  @default(false) @map("weekly_reading_summary")
  monthlyReadingReport  Boolean  @default(false) @map("monthly_reading_report")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_settings")
}

model UserSocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  platform  String
  username  String?
  url       String?
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_social_links")
}

model SeriesOrderIgnoredIssue {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  seriesId    String   @map("series_id") @db.Uuid
  fingerprint String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, seriesId])
  @@map("series_order_ignored_issues")
}

model SeriesOrderDisabledSeries {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
  @@map("series_order_disabled_series")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
