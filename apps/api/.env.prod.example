# LOCAL app pointed at the PROD server's Postgres via SSH tunnel. USE WITH CARE —
# this reads/writes REAL production data.
# Usage:
#   1) open the tunnel (separate terminal):  pnpm tunnel:prod  (local :5533 → prod db)
#   2) run:                                   pnpm dev:api:prod
# Copy this file to .env.prod and fill the blanks. .env.prod is gitignored.
# Field docs live in .env.local.example — this file only notes what differs for prod.
NODE_ENV=development
PORT=4000
# PROD DB over the tunnel. Password = PROD_POSTGRES_PASSWORD (Bitwarden / GitHub Secret).
DATABASE_URL=postgresql://booknest:__PROD_DB_PASSWORD__@localhost:5533/booknest
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
ENABLE_SWAGGER=true
TRACING_ENABLED=false
# Use the PROD environment's JWT secrets (PROD_JWT_ACCESS_SECRET / PROD_JWT_REFRESH_SECRET).
JWT_ACCESS_SECRET=__PROD_JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__PROD_JWT_REFRESH_SECRET__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_SHORT=1
COOKIE_SECURE=false
EMAIL_VERIFICATION_TTL_MINUTES=60
RESEND_COOLDOWN_SECONDS=60
# Mail stays on your LOCAL Mailpit so local runs never send through prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=BookNest <no-reply@book-nest.net>
WEB_BASE_URL=https://book-nest.net
WIKIDATA_CONTACT=book-nest/1.0 (+https://book-nest.net)
