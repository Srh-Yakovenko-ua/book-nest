# =============================================================================
# Env profiles for the API (local development tooling). The loader in
# src/config/env.ts reads .env.${APP_ENV} (default APP_ENV=local):
#
#   .env.local  →  pnpm dev:api        local Docker services (db :5432, Mailpit :1025)
#   .env.dev    →  pnpm dev:api:dev     local app → DEV server DB via SSH tunnel
#   .env.prod   →  pnpm dev:api:prod    local app → PROD server DB via SSH tunnel
#
# Copy each *.example to the same name without ".example" and fill the blanks.
# The real .env.local / .env.dev / .env.prod are gitignored — NEVER commit them.
# NOTE: the deployed dev/prod environments do NOT read these files — their config
# is rendered from GitHub Secrets by the deploy workflow (see deploy/README.md).
# =============================================================================

NODE_ENV=development
PORT=4000

# Postgres — local Docker Postgres from the root docker-compose.yml (pnpm db:up).
DATABASE_URL=postgresql://booknest:booknest_dev_2026@localhost:5432/booknest_dev

# Optional. Only needed if DATABASE_URL points at a pgbouncer transaction pooler
# (e.g. a managed pooler on port 6543). Such poolers don't support the prepared
# statements and session-level operations migrations need, so point `prisma migrate`
# at the direct/session connection here. With our self-hosted Postgres this stays unset,
# and DATABASE_URL is used for both runtime and migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@host:5432/DBNAME

# Comma-separated list of allowed Origins for CORS.
# Local: http://localhost:3000. On the server: the env's site URL
# (https://dev.book-nest.net for dev, https://book-nest.net for prod).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# Swagger UI at /api/docs. Defaults to "true". Set to "false" to hide in any env.
ENABLE_SWAGGER=true

# OpenTelemetry distributed tracing. When "true" the NodeSDK initializes
# auto-instrumentations (http, express, pg, ...) and prints span trees to stdout
# via ConsoleSpanExporter. Keep "false" by default — exporter is noisy.
TRACING_ENABLED=false

# Auth secrets — sign access JWTs (JWT_ACCESS_SECRET) and derive the refresh-token
# store (JWT_REFRESH_SECRET). Two DISTINCT random strings, each >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access-token lifetime, parsed by jose (e.g. "15m", "1h"). Defaults to "15m".
ACCESS_TOKEN_TTL=15m
# Refresh-token (DB session) lifetime in days. Defaults to 7.
REFRESH_TOKEN_TTL_DAYS=7
# Set "true" in production so the refresh cookie is only sent over HTTPS. Defaults to "false".
COOKIE_SECURE=false
# Email verification link lifetime in minutes. Defaults to 60.
EMAIL_VERIFICATION_TTL_MINUTES=60
# Password reset link lifetime in minutes. Defaults to 30.
PASSWORD_RESET_TTL_MINUTES=30
# Minimum gap between two verification emails for the same user, in seconds. Defaults to 60.
# Independent of the IP throttle; a resend inside this window is silently skipped.
RESEND_COOLDOWN_SECONDS=60

# Transactional email (SMTP) — welcome email on registration, etc.
# Local dev: Mailpit from the root docker-compose (SMTP localhost:1025, web UI localhost:8025,
# no auth, not secure). dev/prod: a real SMTP relay; set SMTP_USER/SMTP_PASS and SMTP_SECURE=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER and SMTP_PASS are optional; leave unset for Mailpit (no auth).
# SMTP_USER=
# SMTP_PASS=
# Default From header for outgoing mail. Defaults to "BookNest <no-reply@book-nest.net>".
MAIL_FROM=BookNest <no-reply@book-nest.net>
# Public base URL of the web app, used to build links in emails (Dashboard, add book, settings).
# Local: http://localhost:3000. On the server: https://dev.book-nest.net (dev) / https://book-nest.net (prod).
WEB_BASE_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible object storage) — for file uploads (book covers, avatars).
# NOT yet read by config/env.ts — uncomment + wire when the upload feature lands.
# Real dev creds live in Bitwarden ("Book Nest — R2 dev"); never commit secrets here.
# Per environment: bucket book-nest-dev (dev) / book-nest-prod (prod); locally MinIO or the dev bucket.
# R2_ACCOUNT_ID=
# R2_BUCKET=book-nest-dev
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
