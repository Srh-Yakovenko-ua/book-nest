# Browser-exposed API base URL. Leave empty to call /api via Next rewrites (proxied to API_BASE_URL).
NEXT_PUBLIC_API_BASE_URL=

# Server-side API base URL for SSR/RSC fetches and the /api rewrite proxy target.
API_BASE_URL=http://localhost:4000

# Public site origin, used for sitemap/robots/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error tracking (enable in production)
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics (enable when analytics ships)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
