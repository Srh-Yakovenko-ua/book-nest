# LOCAL web (pnpm dev / pnpm dev:web) talking to the local API on :4000.
# This is the default. You do NOT need this file at all — every var below
# falls back to a localhost default in code (src/lib/env.ts, next.config.ts,
# src/lib/http-client.ts). Copy to .env.local only to override something.
# .env.local is gitignored.

# Browser-exposed API base URL. Leave EMPTY to call /api via Next rewrites:
# the browser hits same-origin /api, proxied server-side to API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=

# Server-side API base URL — SSR/RSC fetches AND the /api rewrite proxy target.
# This is the only var that changes between local / dev / prod.
API_BASE_URL=http://localhost:4000

# Public site origin, used for sitemap/robots/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-exposed origin of the realtime (socket.io) gateway. EMPTY means same
# origin, which is what production wants: Caddy serves /api/* directly and
# upgrades WebSockets. In local dev same-origin /api/* is the Next rewrite
# proxy, which does not upgrade, so point this straight at the API instead.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Error tracking (enable in production)
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics (enable when analytics ships)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
