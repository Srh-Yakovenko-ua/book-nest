{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["lsof"],
  "workspaces": {
    ".": {
      "ignore": ["api/**", ".claude/**"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["orval.config.ts"],
      "ignore": [
        "src/components/ui/**",
        "src/shared/api/generated/**",
        "src/shared/api/mutator.ts",
        "src/test-utils.tsx",
        "src/lib/api-errors.ts",
        "src/lib/format.ts",
        "src/lib/gradient-from-string.ts"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/geist-mono",
        "@fontsource-variable/manrope",
        "@fontsource-variable/playfair-display",
        "@hookform/devtools",
        "@tanstack/query-sync-storage-persister",
        "@tanstack/react-query-persist-client",
        "@tanstack/react-table",
        "@tanstack/react-virtual",
        "input-otp",
        "nanoid",
        "postcss",
        "shadcn",
        "superjson",
        "tailwindcss",
        "ts-pattern",
        "tw-animate-css",
        "type-fest"
      ]
    },
    "apps/api": {
      "project": ["src/**/*.ts", "!src/generated/**"],
      "entry": ["src/index.ts"],
      "prisma": false,
      "ignoreDependencies": ["@prisma/client", "pino-pretty", "ua-parser-js"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
