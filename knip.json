{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["lsof"],
  "workspaces": {
    ".": {
      "ignore": ["api/**", ".claude/**"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "src/components/ui/**",
        "src/test-utils.tsx",
        "src/lib/api-errors.ts",
        "src/lib/format.ts",
        "src/lib/gradient-from-string.ts",
        "src/lib/http-client.ts"
      ],
      "ignoreDependencies": [
        "@app/shared",
        "@fontsource-variable/geist-mono",
        "@fontsource-variable/inter",
        "@fontsource-variable/plus-jakarta-sans",
        "@hookform/devtools",
        "@hookform/resolvers",
        "@tanstack/query-sync-storage-persister",
        "@tanstack/react-query-persist-client",
        "@tanstack/react-table",
        "@tanstack/react-virtual",
        "@testing-library/user-event",
        "cmdk",
        "date-fns",
        "input-otp",
        "nanoid",
        "postcss",
        "react-day-picker",
        "react-hook-form",
        "recharts",
        "shadcn",
        "superjson",
        "tailwindcss",
        "ts-pattern",
        "tw-animate-css",
        "type-fest",
        "vaul",
        "zustand"
      ]
    },
    "apps/api": {
      "project": ["src/**/*.ts", "!src/generated/**"],
      "entry": ["src/index.ts"],
      "ignore": ["src/test/truncate.ts"],
      "prisma": false,
      "ignoreDependencies": [
        "@nestjs/schedule",
        "@nestjs/throttler",
        "@prisma/client",
        "@types/nodemailer",
        "bcryptjs",
        "date-fns",
        "jose",
        "nodemailer",
        "pino-pretty",
        "ua-parser-js"
      ]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
