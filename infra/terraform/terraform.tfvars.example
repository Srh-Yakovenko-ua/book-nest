# Copy to terraform.tfvars (gitignored) and fill in. NON-SECRET values only.
# Secrets (API tokens) go in the environment, NOT here:
#   export TF_VAR_cloudflare_api_token=...
#   export TF_VAR_hcloud_token=...
#   export AWS_ACCESS_KEY_ID=...        # R2 token for the state backend
#   export AWS_SECRET_ACCESS_KEY=...

cloudflare_zone_id = "REPLACE_WITH_ZONE_ID"
server_ipv4        = "46.224.83.71"

# Public key only — matches the CI deploy key pair. Safe to commit, kept here for locality.
ssh_public_key = "ssh-ed25519 AAAA... booknest-deploy"
