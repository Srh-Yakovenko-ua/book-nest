# Copy this file to secrets.env (gitignored), fill in the values, then load it with:
#   source secrets.env
# NEVER commit real values. NEVER paste them into a chat. This file stays on your disk only.

# --- R2 credentials for the Terraform state backend (Phase 0) ---
# Cloudflare > R2 > Manage R2 API Tokens > Create API token > Object Read & Write.
# It gives you an Access Key ID and a Secret Access Key.
export AWS_ACCESS_KEY_ID=''
export AWS_SECRET_ACCESS_KEY=''

# --- Cloudflare API token for the provider (Phase 1: DNS + R2) ---
# Cloudflare > My Profile > API Tokens > Create Token > Custom token:
#   Zone > DNS > Edit           (zone: book-nest.net)
#   Account > Workers R2 Storage > Edit
export TF_VAR_cloudflare_api_token=''

# --- Hetzner token — ONLY for Phase 2 (the server). Leave commented out for now. ---
# Hetzner Cloud console > project > Security > API Tokens > Read & Write.
# export TF_VAR_hcloud_token=''
